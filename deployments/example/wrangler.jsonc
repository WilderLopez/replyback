// Copy this folder to deployments/<project>/, which stays out of git, and fill in the values.
// Secrets do not go here. See docs/DEPLOY.md.
{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "replyback-example",
  "main": "../../worker/src/index.ts",
  "compatibility_date": "2026-11-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replyback-example",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../worker/migrations"
    }
  ],
  // Use a value no other Worker in your account uses: counters are shared per namespace.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  // Optional: a stable URL on your own domain, so you can move accounts without shipping a new app.
  // "routes": [{ "pattern": "support.example.com", "custom_domain": true }],
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    // Neutral text: the reply never travels in the push.
    "PUSH_TITLE": "Support",
    "PUSH_BODY": "You have a new reply"
    // Optional: translation keys that the app resolves on the device.
    // "PUSH_TITLE_LOC_KEY": "replyback_push_title",
    // "PUSH_BODY_LOC_KEY": "replyback_push_body"
  }
}
