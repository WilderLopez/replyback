// Configuración de desarrollo local y tests. Los despliegues reales viven en
// ../deployments/<proyecto>/wrangler.jsonc, fuera de git, y apuntan a este mismo código.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "replyback-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replyback-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": {
    "PUSH_TITLE": "Support",
    "PUSH_BODY": "You have a new reply"
  }
}
