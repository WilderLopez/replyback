{
  "name": "@replyback/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "types": "wrangler types src/worker-configuration.d.ts",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.0"
  }
}
